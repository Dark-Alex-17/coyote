# Reticulum configuration for the Coyote-mesh propagation node.
# Seeded to /data/reticulum/config on first start; edit it there and restart the container.
# Interface options: https://markqvist.github.io/Reticulum/manual/interfaces.html#tcp-server-interface

[reticulum]

# Relay announces and paths between the Coyote nodes that dial in, so this one
# container is both the team's `type: private` relay and its propagation node.
enable_transport = Yes

# Nothing else runs Reticulum inside the container, so no shared-instance socket.
share_instance = No

[interfaces]

  # 4242 is the conventional Reticulum TCP port and what a Coyote node's
  # `mesh.interfaces: [{type: private, host: <this host>, port: 4242}]` dials.
  [[Coyote Peers]]
    type = TCPServerInterface
    enabled = Yes
    listen_ip = 0.0.0.0
    listen_port = 4242

    # Reticulum holds announces from unknown peers by default, which would delay a
    # brand-new Coyote identity's first announce. Off here, as on the repo's test relay.
    ingress_control = No
