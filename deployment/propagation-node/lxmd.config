# lxmd configuration for a Coyote-mesh propagation node.
# Seeded to /data/lxmd/config on first start; edit it there and restart the container.
# Every key is documented in `lxmd --exampleconfig`.

[propagation]

# Run as a propagation node (store-and-forward for LXMF messages).
enable_node = yes

# Only identities listed in /data/lxmd/allowed can fetch held messages.
# One 32-hex-character identity hash per line, nothing else on the line.
# With the file empty, lxmd starts but answers every fetch with no access.
auth_required = yes

# No legitimate peer node exists on a private team network; peering would
# replicate the held store to any propagation node heard within four hops.
autopeer = no

# Announce as soon as the node is up, so a (re)started node is heard at once.
announce_at_start = yes

# Minutes between announces. The upstream example uses 360; a Coyote node that
# starts after this one only learns of it from the next announce, so keep it short,
# but not under an hour: a relay rate-limits announces per destination (RNS
# announce_rate_target = 3600 s, announce_rate_grace = 5) and, past the grace, stops
# forwarding this node's announces, so late joiners behind the relay never hear it.
# The rate check is a strict compare (an announce less than 3600 s after the last
# counts), so exactly 60 minutes lands early about half the time; 61 stays clear, as
# Coyote's own hourly heartbeat does with a minute of slack.
announce_interval = 61

# Optional name shown to peers in the node's announce.
# node_name = Team propagation node

[lxmf]

# Display name of the daemon's own delivery destination. It is not the node name.
display_name = Coyote propagation node

# The delivery destination is not announced; only the propagation node is.
announce_at_start = no

[logging]

# 0 (critical only) through 7 (extreme); 4 is info, as in upstream's example config
# (unset, lxmd uses 3). Logs go to stdout.
loglevel = 4
