# Reticulum configuration rendered by /usr/local/bin/coyote-entrypoint on first start
# (into $HOME/.reticulum/config; never overwritten: edit it there, or mount your own).
# Interface options: https://markqvist.github.io/Reticulum/manual/interfaces.html

[reticulum]

# Relay announces and paths between the Coyote sessions that dial in. A transport
# node also forwards traffic for any other Reticulum peer it hears on its interfaces.
enable_transport = True

# Shared instance left at the default so rnstatus and rnpath inside the container
# attach to this daemon instead of binding 4242 again.

[logging]

# rnsd applies its -v flags only when this section exists (Reticulum.py:459-467).
# 4 = LOG_INFO, the value RNS's own default config ships; -vv on top reaches LOG_DEBUG.
loglevel = 4

[interfaces]

#@if lan
  # Link-local discovery of other hosts on the same LAN; needs --network host.
  [[Coyote Local]]
    type = AutoInterface
    enabled = Yes

#@end
  # The loopback hop every Coyote session in this container dials.
  [[Coyote Sessions]]
    type = TCPServerInterface
    enabled = Yes
    listen_ip = 127.0.0.1
    listen_port = 4242

    # Reticulum holds announces from unknown peers by default, which would delay a
    # brand-new Coyote identity's first announce. Off here, as on the repo's test relay.
    ingress_control = No
#@if relay

  # Your team's relay (a propagation node or another rnsd reachable over the network).
  [[Team Relay]]
    type = TCPClientInterface
    enabled = Yes
    target_host = @RELAY_HOST@
    target_port = @RELAY_PORT@
#@end
